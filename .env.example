# Tạo một chuỗi bí mật riêng; frontend gửi dưới dạng Bearer token
NPL_API_KEY=thay-bang-chuoi-ngau-nhien-dai
# Chỉ định domain frontend của bạn khi deploy; không để * trên production
CORS_ORIGINS=https://your-npl-studio-domain.example
# Nếu SDK cần thông tin phiên hợp lệ, đặt ở môi trường máy chủ, không đưa vào APK
# CAPCUT_COOKIE=
# CAPCUT_BEARER=
